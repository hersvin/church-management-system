# Copy to .env (or .env.local) and adjust. Values starting with EXPO_PUBLIC_ are built into the app,
# so never put secrets here. Restart Expo after changing this file (a reload is not enough).

# Church API address the phone can reach. Leave it unset in development and the app uses the
# computer that serves it (the address Expo shows, port 4000). Set it for production or a fixed server.
# EXPO_PUBLIC_API_URL=http://192.168.5.53:4000
EXPO_PUBLIC_API_URL=
