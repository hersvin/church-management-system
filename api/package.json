{
  "name": "@cms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm --filter @cms/database generate",
    "db:migrate": "pnpm --filter @cms/database migrate:dev",
    "db:migrate:create": "pnpm --filter @cms/database migrate:create",
    "db:deploy": "pnpm --filter @cms/database migrate:deploy",
    "db:status": "pnpm --filter @cms/database migrate:status",
    "db:seed": "pnpm --filter @cms/database seed",
    "db:reset": "pnpm --filter @cms/database migrate:reset",
    "db:studio": "pnpm --filter @cms/database studio"
  },
  "dependencies": {
    "@cms/database": "workspace:*",
    "@cms/shared": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@scalar/nestjs-api-reference": "^1.2.41",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
