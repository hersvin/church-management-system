{
  "expo": {
    "name": "Grace Church",
    "slug": "grace-church",
    "scheme": "gracechurch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f1ea",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.gracechurch.app"
    },
    "android": {
      "package": "org.gracechurch.app",
      "adaptiveIcon": {
        "backgroundColor": "#f4f1ea",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f1ea",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans church check-in codes and can take your profile photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo from your library for your church profile.",
          "cameraPermission": "Take a photo for your church profile."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
